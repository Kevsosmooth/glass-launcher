<?xml version="1.0" encoding="utf-8"?>
<!-- Home button helper: only window changes of the stock home screens, plus key filtering for
     the Home key. No window content. packageNames matches STOCK_HOME_PACKAGES in HomeRedirect.kt. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/home_helper_service_description"
    android:notificationTimeout="0"
    android:packageNames="com.amazon.tv.launcher,com.google.android.apps.tv.launcherx,com.google.android.tvlauncher" />
