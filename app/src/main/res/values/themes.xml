<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window so a cold start never flashes white before the wallpaper is drawn. -->
    <style name="Theme.Glass" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:colorBackground">@color/window</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
